{
  "manifest_version": 3,
  "name": "Hush: AI Notification Center",
  "version": "1.0.0",
  "description": "Intelligent, privacy-first AI Notification Center for Chrome.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Hush AI Notification Center",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/hook.js",
        "assets/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
